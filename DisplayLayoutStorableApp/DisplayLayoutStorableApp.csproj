<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>

    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--SYSLIB0051: serialization constructors in the generated DBTestDataSet.Designer.cs (net8)-->
    <NoWarn>$(NoWarn);SYSLIB0051</NoWarn>
  </PropertyGroup>

  <!--EhLibPackageId is the EhLib.WinForms package of the edition (EhLib.WinForms.SourceIncluded,
      EhLib.WinForms.WithoutSource or EhLib.WinForms.Trial); it is set in Directory.Build.props
      next to the solution. Version="2.0.*" takes the newest 2.0.x package from the package sources.-->
  <ItemGroup>
    <PackageReference Include="$(EhLibPackageId)" Version="2.0.*" />
  </ItemGroup>

  <!--JSON of the stored layout (StorableSettingsJsonHelper): JavaScriptSerializer on net48,
      System.Text.Json (part of .NET) on net8-->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Web.Extensions" />
    <!--TypedTableBase<> of the typed DataSet-->
    <Reference Include="System.Data.DataSetExtensions" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="DBTestDataSet.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>DBTestDataSet.xsd</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="dBTestDataSet-DbData.Xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="DBTestDataSet.xsd">
      <Generator>MSDataSetGenerator</Generator>
      <LastGenOutput>DBTestDataSet.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>