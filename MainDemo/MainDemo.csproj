<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>

    <!--Keep .NET Framework first: VS designs forms for the first framework only, and with net8.0-windows first
        EhLib loses design-time (VS bug dotnet/sdk#55954). The order does not affect running.-->
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>

    <!--Do not delete. This is used for testing .NET 8.0 designers.-->
    <!--<TargetFramework>net8.0-windows</TargetFramework>-->

    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>

    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>

    <ApplicationIcon>EhLibBrand16.ico</ApplicationIcon>

    <!--Resource names of forms by their class (namespace + class name), as in the old project. On net48 the SDK
        otherwise names them by folder: Solutions\X.resx -> MainDemo.Solutions.X.resources, but the class is MainDemo.X-->
    <EmbeddedResourceUseDependentUponConvention>true</EmbeddedResourceUseDependentUponConvention>

    <!--SYSLIB0051: serialization constructors in the generated *DataSet.Designer.cs (net8)-->
    <NoWarn>$(NoWarn);SYSLIB0051</NoWarn>
  </PropertyGroup>

  <!--Assembly attributes are taken from Properties\AssemblyInfo.cs.
      GenerateAssemblyInfo itself stays on: the SDK must still emit TargetFramework and, for net8.0-windows,
      SupportedOSPlatform("windows"), otherwise CA1416 fires on every WinForms call.-->
  <PropertyGroup>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <GenerateAssemblyDescriptionAttribute>false</GenerateAssemblyDescriptionAttribute>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <GenerateAssemblyCopyrightAttribute>false</GenerateAssemblyCopyrightAttribute>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
  </PropertyGroup>

  <!-- **************  nuget EhLib.WinForms.<Edition> OR EhLib.WinForms.csproj  -->
  <!--true - reference the library projects from ..\..\Src (only the Source Included edition has the Src folder).-->
  <PropertyGroup>
    <EhLibFromProjects>false</EhLibFromProjects>
  </PropertyGroup>

  <!--EhLibPackageId is the EhLib.WinForms package of the edition (EhLib.WinForms.SourceIncluded,
      EhLib.WinForms.WithoutSource or EhLib.WinForms.Trial); it is set in Directory.Build.props
      next to the solution. Version="2.0.*" takes the newest 2.0.x package from the package sources.-->
  <ItemGroup Condition="'$(EhLibFromProjects)' != 'true'">
    <PackageReference Include="$(EhLibPackageId)" Version="2.0.*" />
  </ItemGroup>

  <ItemGroup Condition="'$(EhLibFromProjects)' == 'true'">
    <ProjectReference Include="..\..\Src\EhLib.WinForms\EhLib.WinForms.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(EhLibFromProjects)' == 'true' And '$(TargetFramework)' == 'net48'">
    <ProjectReference Include="..\..\Src\EhLib.WinForms.Design\EhLib.WinForms.Design.csproj" />
  </ItemGroup>

  <!-- ************** -->
  <!--JSON of the stored layout (StorableSettingsJsonHelper): JavaScriptSerializer on net48,
      System.Text.Json (part of .NET) on net8-->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Web.Extensions" />
    <!--TypedTableBase<> of the typed DataSet-->
    <Reference Include="System.Data.DataSetExtensions" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="BiolifeDataSet.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>BiolifeDataSet.xsd</DependentUpon>
    </Compile>
    <Compile Update="cities10000DataSet.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>cities10000DataSet.xsd</DependentUpon>
    </Compile>
    <Compile Update="NorthwindDataSet.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>NorthwindDataSet.xsd</DependentUpon>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="BiolifeDataSet.xsd">
      <Generator>MSDataSetGenerator</Generator>
      <LastGenOutput>BiolifeDataSet.Designer.cs</LastGenOutput>
    </None>
    <None Update="cities10000DataSet.xsd">
      <Generator>MSDataSetGenerator</Generator>
      <LastGenOutput>cities10000DataSet.Designer.cs</LastGenOutput>
    </None>
    <None Update="NorthwindDataSet.xsd">
      <Generator>MSDataSetGenerator</Generator>
      <LastGenOutput>NorthwindDataSet.Designer.cs</LastGenOutput>
    </None>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <!--Data and texts read at run time from the application folder-->
  <ItemGroup>
    <None Update="Data\*.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Doc\*.rtf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>